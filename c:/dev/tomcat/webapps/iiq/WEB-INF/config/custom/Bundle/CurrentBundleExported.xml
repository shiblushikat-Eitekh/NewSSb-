<Bundle iiqElevatedAccess="true" name="Standard Employee - AD Access" significantModified="1785734355516" type="it">
  <ActivityConfig allEnabled="true"/>
  <Attributes>
    <Map>
      <entry key="accountSelectorRules"/>
      <entry key="allowDuplicateAccounts" value="false"/>
      <entry key="allowMultipleAssignments" value="false"/>
      <entry key="mergeTemplates" value="true"/>
      <entry key="sysDescriptions">
        <value>
          <Map>
            <entry key="en_US"/>
          </Map>
        </value>
      </entry>
    </Map>
  </Attributes>
  <Owner>
    <Reference class="sailpoint.object.Identity" name="spadmin"/>
  </Owner>
  <ProvisioningForms>
    <Form name="Create AD Account">
      <Attributes>
        <Map>
          <entry key="IIQTemplateOwnerDefinition">
            <value>
              <DynamicValue value="IIQRequester"/>
            </value>
          </entry>
          <entry key="pageTitle" value="Create AD Account"/>
          <entry key="title" value="Create AD Account"/>
        </Map>
      </Attributes>
      <Section name="Account">
        <Field displayName="sAMAccountName" name="sAMAccountName" type="string">
          <Script>
            <Source>String first = identity.getAttribute("firstname");
String last  = identity.getAttribute("lastname");
return (first + "." + last).toLowerCase();</Source>
          </Script>
        </Field>
        <Field displayName="CN" name="CN" type="string">
          <Script>
            <Source>String first = identity.getAttribute("firstname");
String last  = identity.getAttribute("lastname");
return first + " " + last;</Source>
          </Script>
        </Field>
        <Field displayName="distinguishedName" name="distinguishedName" type="string">
          <Script>
            <Source>String cn   = identity.getAttribute("firstname") + " "
            + identity.getAttribute("lastname");
return "CN=" + cn + ",OU=" + ",OU=Users,DC=sailpoint,DC=local";</Source>
          </Script>
        </Field>
      </Section>
    </Form>
  </ProvisioningForms>
  <RoleIndex/>
